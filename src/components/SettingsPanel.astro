---
import TicketProfileFields from './TicketProfileFields.astro';
---

<section class="settings-panel" aria-hidden="true" aria-label="Edit Profile Demonstrational">
	<header class="settings-title">Edit Profile</header>
	<div class="settings-scroll">
		<form class="settings-form" data-settings-form>
			<p class="settings-lead">Demonstrational</p>
			<TicketProfileFields prefix="settings" />
			<p class="form-status" data-settings-status aria-live="polite"></p>
			<button class="form-primary" type="submit">Save changes</button>
			<button class="form-secondary" type="button" data-clear-local-data>Delete local data</button>
		</form>
	</div>
</section>
