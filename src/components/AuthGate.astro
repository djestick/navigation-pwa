---
import TicketProfileFields from './TicketProfileFields.astro';
---

<section class="auth-gate pending" data-auth-gate aria-hidden="true" aria-label="Account access">
	<div class="auth-shell">
		<img class="auth-logo" src="/icons/db-logo.svg" alt="DB" />
		<h1>DB Navigator</h1>
		<p class="auth-intro">Sign in to access your subscription ticket.</p>

		<div class="auth-tabs" role="tablist" aria-label="Account action">
			<button type="button" class="active" data-auth-tab="login">Log in</button>
			<button type="button" data-auth-tab="register">Register</button>
		</div>

		<form class="auth-form" data-auth-form="login">
			<label>
				<span>Email</span>
				<input name="email" type="email" autocomplete="email" required />
			</label>
			<label>
				<span>Password</span>
				<input name="password" type="password" autocomplete="current-password" minlength="6" required />
			</label>
			<p class="form-status" data-login-status aria-live="polite"></p>
			<button class="form-primary" type="submit">Log in</button>
		</form>

		<form class="auth-form register-form" data-auth-form="register" hidden>
			<label>
				<span>Email</span>
				<input name="email" type="email" autocomplete="email" required />
			</label>
			<label>
				<span>Password</span>
				<input name="password" type="password" autocomplete="new-password" minlength="6" required />
			</label>
			<TicketProfileFields prefix="register" />
			<p class="form-status" data-register-status aria-live="polite"></p>
			<button class="form-primary" type="submit">Create account</button>
		</form>
	</div>
</section>
