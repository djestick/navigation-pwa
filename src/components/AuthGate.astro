---
import TicketProfileFields from './TicketProfileFields.astro';
---

<section class="auth-gate pending" data-auth-gate aria-hidden="true" aria-label="Account access">
	<div class="auth-shell">
		<img class="auth-logo" src="/icons/db-logo.svg" alt="DB" />
		<h1>DB Navigator</h1>
		<p class="auth-intro">Set up your ticket. Everything stays on this iPhone.</p>

		<form class="auth-form register-form" data-local-setup-form>
			<label>
				<span>Email</span>
				<input name="email" type="email" autocomplete="email" />
			</label>
			<TicketProfileFields prefix="setup" />
			<p class="form-status" data-setup-status aria-live="polite"></p>
			<button class="form-primary" type="submit">Save on this iPhone</button>
		</form>
	</div>
</section>
