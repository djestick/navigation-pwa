	.app-shell.nearby-active { background: transparent; }
	.system-safe-area { position: absolute; z-index: 30; inset: 0 0 auto; height: var(--safe-top); background: var(--chrome); pointer-events: none; }
	.app-shell.nearby-active .system-safe-area { background: transparent; }
	main { position: absolute; inset: var(--safe-top) 0 var(--nav-height); }
	*, *::before, *::after { box-sizing: border-box; }
