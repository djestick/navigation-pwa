		pointer-events: none;
		transition: opacity .2s ease, visibility 0s linear .2s;
	}
	.auth-shell {
		width: 100%;
		height: 100%;
		padding: calc(var(--safe-top) + 30px) 24px 50px;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
	}
	.auth-logo { display: block; width: 70px; height: 49px; margin: 0 auto 14px; object-fit: contain; }
	.auth-shell > h1 { font-size: 25px; text-align: center; }
