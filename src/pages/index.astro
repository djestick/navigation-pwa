	.screen[data-screen="booking"] { background: var(--chrome); }
	.screen::-webkit-scrollbar { display: none; }
	.screen.active { display: block; }
	svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
	.content { padding: 0 28px 55px; background: var(--bg); }
	h1,h2,h3,p { margin: 0; }

	.auth-gate {
		position: absolute;
		z-index: 90;
		inset: 0;
		color: #f4f4f5;
		background: var(--bg);
		opacity: 1;
		visibility: visible;
		transition: opacity .2s ease, visibility 0s;
	}
