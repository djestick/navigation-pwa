---
import SectionHeader from '../components/SectionHeader.astro';
import TicketDetail from '../components/TicketDetail.astro';
import AuthGate from '../components/AuthGate.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="apple-touch-startup-image" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-startup/launch-1290x2796.png" />
		<link rel="apple-touch-startup-image" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-startup/launch-1284x2778.png" />
		<link rel="apple-touch-startup-image" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-startup/launch-1179x2556.png" />
		<link rel="apple-touch-startup-image" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-startup/launch-1170x2532.png" />
		<link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-startup/launch-1125x2436.png" />
		<link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href="/apple-startup/launch-828x1792.png" />
		<link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href="/apple-startup/launch-750x1334.png" />
		<meta name="viewport" content="width=device-width, height=device-height, initial-scale=1, viewport-fit=cover, user-scalable=no" />
		<meta id="theme-color" name="theme-color" content="#292c38" />
		<meta name="color-scheme" content="dark" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="DB Simulator" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="generator" content={Astro.generator} />
		<title>DB Simulator</title>
	</head>
	<body>
		<svg class="svg-defs" aria-hidden="true">
			<symbol id="i-route" viewBox="0 0 32 32"><path d="M6 6h10a4 4 0 0 1 0 8H9m0 0 4-4m-4 4 4 4m13 8H16a4 4 0 0 1 0-8h7m0 0-4-4m4 4-4 4"/></symbol>
			<symbol id="i-pin" viewBox="0 0 32 32"><path d="M16 27s8-8.2 8-15a8 8 0 1 0-16 0c0 6.8 8 15 8 15Z"/><circle cx="16" cy="12" r="2.5"/><path d="M10 29h12"/></symbol>
			<symbol id="i-ticket" viewBox="0 0 32 32"><path d="M5 9h22v5a3 3 0 0 0 0 6v5H5v-5a3 3 0 0 0 0-6V9Z"/><path d="M11 14h2m3 0h2m3 0h2"/></symbol>
			<symbol id="i-profile" viewBox="0 0 32 32"><rect x="5" y="7" width="22" height="19" rx="1"/><circle cx="16" cy="14" r="3"/><path d="M10 23c1.2-4.7 10.8-4.7 12 0"/></symbol>
			<symbol id="i-calendar" viewBox="0 0 32 32"><rect x="6" y="8" width="20" height="18" rx="1"/><path d="M10 5v6m12-6v6M6 14h20"/></symbol>
			<symbol id="i-user" viewBox="0 0 32 32"><circle cx="16" cy="9" r="4"/><path d="M8 27v-6c0-5 16-5 16 0v6"/></symbol>
			<symbol id="i-sliders" viewBox="0 0 32 32"><path d="M4 8h24M4 16h24M4 24h24"/><circle cx="11" cy="8" r="3"/><circle cx="21" cy="16" r="3"/><circle cx="14" cy="24" r="3"/></symbol>
			<symbol id="i-search" viewBox="0 0 32 32"><circle cx="14" cy="14" r="8"/><path d="m20 20 7 7"/></symbol>
			<symbol id="i-star" viewBox="0 0 32 32"><path d="m16 3 4 8 9 1-6.5 6.5 1.5 9L16 23l-8 4.5 1.5-9L3 12l9-1 4-8Z"/></symbol>
			<symbol id="i-chevron" viewBox="0 0 32 32"><path d="m12 6 10 10-10 10"/></symbol>
			<symbol id="i-plus" viewBox="0 0 32 32"><path d="M16 5v22M5 16h22"/></symbol>
			<symbol id="i-location" viewBox="0 0 32 32"><path d="m26 5-9 22-3-9-9-3 21-10Z"/></symbol>
		</svg>

		<div class="app-shell">
			<div class="system-safe-area" aria-hidden="true"></div>

			<main>
				<section class="screen active" data-screen="booking">
					<div class="booking-top">
						<button class="journey-type">Single journey</button>
						<div class="route-fields">
							<div>Bahnhof/ZOB, Hameln</div>
							<div>Hannover Hbf</div>
							<button class="swap" aria-label="Swap origin and destination"><img src="/icons/route-swap.svg" alt="" /></button>
						</div>
						<div class="options">
							<div><svg><use href="#i-calendar"/></svg><span>Date</span><strong id="arrival-time">Arr | Today, --:--</strong><svg><use href="#i-chevron"/></svg></div>
							<div><svg><use href="#i-user"/></svg><span>Passengers, bicycles</span><strong>1 pers. | 2nd Cl.</strong><svg><use href="#i-chevron"/></svg></div>
							<div><img class="option-icon" src="/icons/transport-options.svg" alt="" /><span>Options</span><strong>Means of transport: All</strong><svg><use href="#i-chevron"/></svg></div>
							<div><img class="option-icon fastest" src="/icons/fastest-connections.png" alt="" /><span>Show fastest connections<small>What does that mean?</small></span><strong>Active</strong><svg><use href="#i-chevron"/></svg></div>
						</div>
						<button class="search-button">Search</button>
					</div>
					<div class="content">
						<SectionHeader title="My favourites" />
						<div class="mini-card"><svg class="star"><use href="#i-star"/></svg><strong>Bad Pyrmont</strong></div>
						<div class="dots"><b></b><i></i><i></i><i></i><i></i></div>

						<SectionHeader title="Tickets & offers" />
						<div class="feature-card">
							<img class="card-art" src="/icons/bahncard.svg" alt="" />
							<div><h3>BahnCard</h3><p>Find the right BahnCard here.</p></div>
						</div>
						<div class="dots"><i></i><b></b><i></i><i></i></div>

						<SectionHeader title="Feedback & news" />
						<div class="feature-card">
							<img class="card-art" src="/icons/construction.svg" alt="" />
							<div><h3>Baustellen der DB</h3><p>Informieren Sie sich über die Baustellen im Fern- und Nahverkehr</p></div>
						</div>
						<div class="dots"><i></i><b></b><i></i></div>
					</div>
				</section>

				<section class="screen nearby-screen" data-screen="nearby">
					<button class="map-search" aria-label="Search stop or station">
						<span>Search stop, station</span>
						<svg><use href="#i-search"/></svg>
					</button>
					<div class="map-consent">
						<h1>Activate map</h1>
						<div class="consent-accent"></div>
						<p>We need your consent to activate the map service in order to display your location on the map and stops and sharing services nearby. Afterwards, we transmit the necessary positional data to the Apple Maps service of Apple Inc.</p>
						<p>Your consent will also apply to future uses of the map function as long as you do not deactivate the display of the map in the app settings. You can withdraw your consent at any time in the app settings.</p>
						<button class="more-information"><span>›</span> More information</button>
						<button class="agree-button">Agree</button>
					</div>
					<div class="transport-drawer">
						<div class="grabber"></div>
						<div class="transport-tabs">
							<span class="selected"><img src="/icons/public-transport.png" alt="" />Public tran...</span>
							<span><img src="/icons/bike.png" alt="" />Bike</span>
							<span><img src="/icons/scooter.png" alt="" />Scooter</span>
						</div>
					</div>
				</section>

				<section class="screen" data-screen="journeys">
					<header class="title-row">
						<button class="header-icon" aria-label="Journey filters"><img src="/icons/transport-options.svg" alt="" /></button>
						<h1>Journeys</h1>
						<button class="header-icon plus" aria-label="Add journey"><img src="/icons/journeys-plus.svg" alt="" /></button>
					</header>
					<div class="journeys-initial">
						<div class="journeys-empty">
							<div class="empty-art" aria-hidden="true">
								<img src="/icons/no-trips.png" alt="" />
								<i></i>
							</div>
							<h2>No trips exist</h2>
							<p>No tickets have been purchased or trips bookmarked.</p>
							<button class="refresh-button">Refresh</button>
						</div>
						<div class="previous-trips">
							<h2>Previous trips</h2>
							<button>Tickets and trips</button>
						</div>
					</div>
					<div class="journeys-loading" aria-label="Loading journeys"><span class="ios-spinner"></span></div>
					<div class="journeys-loaded content">
						<h2>BahnCards, season tickets & subscriptions</h2>
						<div class="ticket-card" role="button" tabindex="0" aria-label="Open Deutschland-Ticket">
							<div class="ticket-head"><img class="ticket-db-logo" src="/icons/db-logo.svg" alt="DB" /><img class="ticket-qr" src="/icons/journey-qr.svg" alt="" /><h3>Deutschland-Ticket DTV, 2nd Cl.</h3></div>
							<div class="ticket-info">
								<p><img src="/icons/journey-map.svg" alt="" /><span>deutschlandweit</span></p>
								<p><img src="/icons/journey-calendar.svg" alt="" /><span data-ticket-card-valid-from></span></p>
								<p><img src="/icons/journey-ticket-info.svg" alt="" /><span>Aktuelle Ticketgültigkeit siehe Ticket.<br/>Aktualisierung automatisch zum Monatswechsel.</span></p>
							</div>
						</div>
						<hr/>
						<h2>Repeat journeys</h2>
						<div class="repeat-card">
							<label>Paused</label><b>Schulzentrum West, Hameln -<br/>Dortmund Hbf</b>
							<p><img src="/icons/journey-bell.svg" alt="" />Tue</p><p><img src="/icons/journey-time.svg" alt="" />12:50 - 16:05</p><button class="toggle" aria-label="Enable repeat journey"></button>
						</div>
						<hr/>
						<h2>Previous trips</h2>
						<div class="previous">Previous and cancelled journeys, BahnCards, season tickets & subscriptions</div>
					</div>
				</section>

				<section class="screen" data-screen="profile">
					<header class="title-row profile-title"><span></span><h1>Profile</h1><span></span></header>
					<div class="content profile-content">
						<SectionHeader title="Personal details" more />
						<div class="info-card"><img class="info-icon" src="/icons/personal.svg" alt="" /><div><b data-profile-name></b><span data-profile-customer-id></span></div></div>

						<SectionHeader title="Login & security" more />
						<div class="info-card"><img class="info-icon" src="/icons/login-security.svg" alt="" /><div><b data-profile-email></b></div></div>

						<SectionHeader title="Means of payment" more />
						<div class="info-card"><img class="info-icon" src="/icons/payment.svg" alt="" /><div><b data-profile-payment></b><span data-profile-payment-name></span></div></div>

						<SectionHeader title="Subscriptions and credits" />
						<div class="feature-card">
							<img class="card-art" src="/icons/manage-subscriptions.svg" alt="" />
							<div><h3>Manage subscriptions</h3><p>Manage your subscriptions in the subscription portal.</p></div>
						</div>

						<SectionHeader title="BahnCard" more />
						<div class="feature-card"><img class="card-art" src="/icons/bahncard.svg" alt="" /><div><h3>Manage BahnCard</h3><p>Manage your BahnCard easily online.</p></div></div>

						<SectionHeader title="BahnBonus" />
						<div class="feature-card"><img class="card-art" src="/icons/bahnbonus.png" alt="" /><div><h3>BahnBonus</h3><p>Take part in the BahnBonus loyalty programme.</p></div></div>

						<SectionHeader title="Favourites" more />
						<div class="favourite-card"><div><svg class="star"><use href="#i-star"/></svg><strong>Bad Pyrmont</strong></div><p>+3 more favourites saved</p></div>

						<SectionHeader title="Newsletter and services" />
						<div class="feature-card"><img class="card-art" src="/icons/manage-settings.svg" alt="" /><div><h3>Manage settings</h3><p>Offers, vouchers, information</p></div></div>

						<SectionHeader title="Benefits" />
						<div class="feature-card"><img class="card-art" src="/icons/benefits.svg" alt="" /><div><h3>Your benefits</h3><p>We are currently preparing new benefits for you. Please check back again later.</p></div></div>

						<div class="settings-list">
							<button type="button" data-open-settings>Edit Profile Demonstrational</button><a>Cancel contract</a><a>Withdrawing from contract</a><a>Help & contact</a><a>Privacy</a><a>Legal notice</a><a>Site notice</a>
						</div>
						<button class="logout" type="button" data-clear-local-data>Delete local data</button>
						<p class="version">DB Simulator 26.8.0 (22001843) ❤️</p>
					</div>
				</section>
			</main>

			<TicketDetail />
			<SettingsPanel />
			<AuthGate />

			<nav class="bottom-nav" aria-label="Main navigation">
				<button class="active" data-target="booking"><img src="/icons/booking.svg" alt="" /><span>Booking</span></button>
				<button data-target="nearby"><img src="/icons/nearby.svg" alt="" /><span>Nearby</span></button>
				<button data-target="journeys"><img src="/icons/journeys.svg" alt="" /><span>Journeys</span></button>
				<button data-target="profile"><img src="/icons/profile.svg" alt="" /><span>Profile</span></button>
			</nav>
		</div>

		<script>
			const buttons = document.querySelectorAll('.bottom-nav button');
			const screens = document.querySelectorAll('.screen');
			const root = document.documentElement;
			const themeColor = document.querySelector('#theme-color');
			const ticketDetail = document.querySelector('.ticket-detail');
			const ticketDetailScroll = document.querySelector('.ticket-detail-scroll');
			const settingsPanel = document.querySelector('.settings-panel');
			const settingsScroll = document.querySelector('.settings-scroll');
			const authGate = document.querySelector('[data-auth-gate]');
			let ticketOpen = false;
			let settingsOpen = false;
			let activeProfile = null;
			const syncViewportHeight = () => {
				const height = Math.round(window.innerHeight);
				const bottomGap = Math.max(
					0,
					Math.min(120, Math.round(window.screen.height - height)),
				);
				root.style.setProperty('--app-height', `${height}px`);
				root.style.setProperty('--canvas-bottom-gap', `${bottomGap}px`);
			};

			const setNearbyCanvas = (active) => {
				root.classList.toggle('nearby-active-page', active);
				document.body.classList.toggle('nearby-active-page', active);
				document.querySelector('.app-shell')?.classList.toggle('nearby-active', active);
				themeColor?.setAttribute('content', active ? '#276957' : '#292c38');
			};

			const setTicketOpen = (open, instant = false) => {
				ticketOpen = open;
				ticketDetail?.classList.toggle('no-transition', instant);
				ticketDetail?.classList.toggle('open', open);
				ticketDetail?.setAttribute('aria-hidden', String(!open));
				themeColor?.setAttribute('content', open ? '#f2f2f4' : '#292c38');
				if (open && ticketDetailScroll instanceof HTMLElement) ticketDetailScroll.scrollTop = 0;
				if (instant && ticketDetail instanceof HTMLElement) {
					void ticketDetail.offsetWidth;
					ticketDetail.classList.remove('no-transition');
				}
			};

			const setSettingsOpen = (open, instant = false) => {
				settingsOpen = open;
				settingsPanel?.classList.toggle('no-transition', instant);
				settingsPanel?.classList.toggle('open', open);
				settingsPanel?.setAttribute('aria-hidden', String(!open));
				themeColor?.setAttribute('content', '#292c38');
				if (open && settingsScroll instanceof HTMLElement) settingsScroll.scrollTop = 0;
				if (instant && settingsPanel instanceof HTMLElement) {
					void settingsPanel.offsetWidth;
					settingsPanel.classList.remove('no-transition');
				}
			};

			const securityAssets = {
				cross: '/icons/security-cross.svg',
				waves: '/icons/security-waves.svg',
				dateLine: '/icons/security-date-line.png',
			};
			const securityImageCache = new Map();
			const loadSecurityImage = (src) => {
				if (!securityImageCache.has(src)) {
					securityImageCache.set(src, new Promise((resolve, reject) => {
						const image = new Image();
						image.onload = () => resolve(image);
						image.onerror = reject;
						image.src = src;
					}));
				}
				return securityImageCache.get(src);
			};
			const fitCanvasFont = (context, text, maxWidth, weight, startSize) => {
				let size = startSize;
				do {
					context.font = `${weight} ${size}px "Arial Narrow", Arial, sans-serif`;
					size -= .5;
				} while (context.measureText(text).width > maxWidth && size > 6);
			};
			const drawSecurityNumber = (context, value, y, height, alpha = 1) => {
				const numberLayer = document.createElement('canvas');
				numberLayer.width = 480;
				numberLayer.height = 48;
				const numberContext = numberLayer.getContext('2d', { willReadFrequently: true });
				if (!numberContext) return;
				numberContext.textAlign = 'left';
				numberContext.textBaseline = 'alphabetic';
				let x = 8;
				[...value].forEach((character, index) => {
					const highlighted = index === 2 || index === 5;
					numberContext.font = `800 ${highlighted ? 38 : 32}px "Arial Narrow", Arial, sans-serif`;
					numberContext.fillStyle = highlighted ? '#858486' : '#c8c7c9';
					numberContext.fillText(character, x, 41);
					x += numberContext.measureText(character).width;
				});

				const pixels = numberContext.getImageData(0, 0, numberLayer.width, numberLayer.height);
				let minX = numberLayer.width;
				let minY = numberLayer.height;
				let maxX = 0;
				let maxY = 0;
				for (let pixelY = 0; pixelY < numberLayer.height; pixelY += 1) {
					for (let pixelX = 0; pixelX < numberLayer.width; pixelX += 1) {
						if (pixels.data[(pixelY * numberLayer.width + pixelX) * 4 + 3] === 0) continue;
						minX = Math.min(minX, pixelX);
						minY = Math.min(minY, pixelY);
						maxX = Math.max(maxX, pixelX);
						maxY = Math.max(maxY, pixelY);
					}
				}
				if (maxX <= minX || maxY <= minY) return;
				context.save();
				context.globalAlpha = alpha;
				context.drawImage(
					numberLayer,
					minX,
					minY,
					maxX - minX + 1,
					maxY - minY + 1,
					0,
					y,
					context.canvas.width,
					height,
				);
				context.restore();
			};
			const drawBackgroundText = (context, canvas, ticketData) => {
				const serial = `${ticketData.orderNumber}${ticketData.position}`;
				const tokens = [
					'2. Kl.',
					'1 Pers. (ab 6J.)',
					ticketData.passenger,
					'Deutschland-Ticket',
					ticketData.validFrom,
					serial,
					'Fahrkarte',
				];
				let seed = Number.parseInt(ticketData.orderNumber, 10) || 1;
				const random = () => {
					seed = (seed * 1664525 + 1013904223) >>> 0;
					return seed / 4294967296;
				};
				context.save();
				context.beginPath();
				context.rect(0, 29, canvas.width, 101);
				context.clip();
				context.translate(-23, 39);
				context.rotate(-8 * Math.PI / 180);
				context.fillStyle = '#c5c4c5';
				context.font = '700 10px Arial, sans-serif';
				for (let row = 0; row < 14; row += 1) {
					const rowTokens = [...tokens];
					for (let index = rowTokens.length - 1; index > 0; index -= 1) {
						const swapIndex = Math.floor(random() * (index + 1));
						[rowTokens[index], rowTokens[swapIndex]] = [rowTokens[swapIndex], rowTokens[index]];
					}
					const phrase = `${rowTokens.join('  ')}  `;
					let x = -Math.floor(random() * 75);
					while (x < 300) {
						context.fillText(phrase, x, row * 9.5);
						x += context.measureText(phrase).width;
					}
				}
				context.restore();
			};
			const drawWaveLayer = (context, waves) => {
				if (!waves) return;
				const waveLayer = document.createElement('canvas');
				waveLayer.width = 250;
				waveLayer.height = 132;
				const waveContext = waveLayer.getContext('2d');
				if (!waveContext) return;
				waveContext.drawImage(waves, 0, 0, waveLayer.width, waveLayer.height);
				waveContext.globalCompositeOperation = 'source-in';
				waveContext.fillStyle = '#b0afb2';
				waveContext.fillRect(0, 0, waveLayer.width, waveLayer.height);
				waveContext.globalCompositeOperation = 'destination-in';
				const fade = waveContext.createLinearGradient(0, 0, waveLayer.width, 0);
				fade.addColorStop(0, 'rgba(0,0,0,0)');
				fade.addColorStop(.42, 'rgba(0,0,0,.22)');
				fade.addColorStop(1, 'rgba(0,0,0,1)');
				waveContext.fillStyle = fade;
				waveContext.fillRect(0, 0, waveLayer.width, waveLayer.height);
				context.save();
				context.beginPath();
				context.rect(0, 29, 196, 101);
				context.clip();
				context.drawImage(waveLayer, -22, 20);
				context.restore();
			};
			const drawSecurityPhoto = (context, image, canvas) => {
				const width = canvas.width * .34;
				const height = width * (image.naturalHeight / image.naturalWidth);
				const y = Math.max(0, Math.min(canvas.height * .32, canvas.height - height));
				context.drawImage(image, canvas.width * .53, y, width, height);
			};
			const securityRenderTokens = new WeakMap();
			const renderSecurityTicket = async (canvas) => {
				if (!(canvas instanceof HTMLCanvasElement)) return;
				const context = canvas.getContext('2d');
				if (!context) return;
				const renderToken = (securityRenderTokens.get(canvas) ?? 0) + 1;
				securityRenderTokens.set(canvas, renderToken);
				const ticketData = {
					passenger: canvas.dataset.passenger ?? '',
					birthDate: canvas.dataset.birthDate ?? '',
					validFrom: canvas.dataset.validFrom ?? '',
					validDay: canvas.dataset.validDay ?? '',
					validMonth: canvas.dataset.validMonth ?? '',
					orderNumber: canvas.dataset.orderNumber ?? '',
					position: (canvas.dataset.position ?? '').replace(/\D/g, ''),
					securityPhotoUrl: canvas.dataset.securityPhotoUrl ?? '',
				};
				const serial = `${ticketData.orderNumber}${ticketData.position}`;
				const [cross, waves, dateLine, securityPhoto] = await Promise.all([
					loadSecurityImage(securityAssets.cross).catch(() => null),
					loadSecurityImage(securityAssets.waves).catch(() => null),
					loadSecurityImage(securityAssets.dateLine).catch(() => null),
					ticketData.securityPhotoUrl
						? loadSecurityImage(ticketData.securityPhotoUrl).catch(() => null)
						: Promise.resolve(null),
				]);
				if (securityRenderTokens.get(canvas) !== renderToken) return;
				context.clearRect(0, 0, canvas.width, canvas.height);
				context.fillStyle = '#fff';
				context.fillRect(0, 0, canvas.width, 30);
				drawWaveLayer(context, waves);
				if (cross) {
					context.globalAlpha = .9;
					context.drawImage(cross, 3, 48, 76, 77);
					context.globalAlpha = 1;
				}
				drawBackgroundText(context, canvas, ticketData);
				drawSecurityNumber(context, serial, 0, 30);

				if (securityPhoto) {
					context.save();
					context.globalAlpha = .8;
					drawSecurityPhoto(context, securityPhoto, canvas);
					context.restore();
				}

				context.textAlign = 'center';
				context.fillStyle = '#050505';
				fitCanvasFont(context, ticketData.passenger, 126, '800', 14);
				context.fillText(ticketData.passenger, 118, 65);
				fitCanvasFont(context, ticketData.birthDate, 110, '800', 13);
				context.fillText(ticketData.birthDate, 118, 83);

				context.textAlign = 'left';
				context.fillStyle = '#636265';
				context.font = '400 29px "Arial Narrow", Arial, sans-serif';
				context.fillText(ticketData.validDay, 7, 100);
				context.fillText(ticketData.validMonth, 47, 100);
				if (dateLine) context.drawImage(dateLine, 5, 106, 65, 5);

				context.fillStyle = '#fff';
				context.fillRect(0, 130, canvas.width, 30);
				context.save();
				context.translate(0, canvas.height);
				context.scale(1, -1);
				drawSecurityNumber(context, serial, 0, 30, .48);
				context.restore();
			};
			document.querySelectorAll('.security-ticket').forEach((canvas) => {
				renderSecurityTicket(canvas);
				new MutationObserver(() => renderSecurityTicket(canvas)).observe(canvas, {
					attributes: true,
					attributeFilter: ['data-passenger', 'data-birth-date', 'data-valid-from', 'data-valid-day', 'data-valid-month', 'data-order-number', 'data-position', 'data-security-photo-url'],
				});
			});

			const padDatePart = (value) => String(value).padStart(2, '0');
			const formatStoredDate = (value) => {
				const [year, month, day] = String(value ?? '').split('-');
				return year && month && day ? `${day}.${month}.${year}` : '';
			};
			const calculateValidity = (validFrom, validUntil) => ({
				validFrom: formatStoredDate(validFrom),
				validUntil: formatStoredDate(validUntil),
			});
			const formatPurchasedAt = (value) => {
				const [date, time] = String(value ?? '').split('T');
				return date && time ? `${formatStoredDate(date)} um ${time.slice(0, 5)} Uhr` : '';
			};
			const setText = (selector, value) => {
				const target = document.querySelector(selector);
				if (target) target.textContent = value;
			};
			const setDataText = (selector, value) => {
				const target = document.querySelector(selector);
				if (!target) return;
				const normalized = String(value ?? '').trim();
				target.textContent = normalized;
			};
			const profileCacheKey = 'db-navigator-profile-v2';
			const mediaDatabaseName = 'db-navigator-local-media';
			const openMediaDatabase = () => new Promise((resolve, reject) => {
				const request = indexedDB.open(mediaDatabaseName, 1);
				request.onupgradeneeded = () => request.result.createObjectStore('images');
				request.onsuccess = () => resolve(request.result);
				request.onerror = () => reject(request.error);
			});
			const writeMedia = async (key, file) => {
				if (!(file instanceof File) || !file.size) return;
				const database = await openMediaDatabase();
				await new Promise((resolve, reject) => {
					const transaction = database.transaction('images', 'readwrite');
					transaction.objectStore('images').put(file, key);
					transaction.oncomplete = resolve;
					transaction.onerror = () => reject(transaction.error);
				});
				database.close();
			};
			const readMediaUrl = async (key) => {
				const database = await openMediaDatabase();
				const blob = await new Promise((resolve, reject) => {
					const request = database.transaction('images').objectStore('images').get(key);
					request.onsuccess = () => resolve(request.result);
					request.onerror = () => reject(request.error);
				});
				database.close();
				return blob instanceof Blob ? URL.createObjectURL(blob) : '';
			};
			const clearMedia = async () => {
				const database = await openMediaDatabase();
				await new Promise((resolve, reject) => {
					const transaction = database.transaction('images', 'readwrite');
					transaction.objectStore('images').clear();
					transaction.oncomplete = resolve;
					transaction.onerror = () => reject(transaction.error);
				});
				database.close();
			};
			const readCachedProfile = () => {
				try {
					const cached = localStorage.getItem(profileCacheKey);
					return cached ? JSON.parse(cached) : null;
				} catch {
					return null;
				}
			};
			const cacheProfile = (profile) => {
				try {
					const { qrUrl, securityPhotoUrl, ...storedProfile } = profile;
					localStorage.setItem(profileCacheKey, JSON.stringify(storedProfile));
				} catch {}
			};
			const randomDigits = (length) => {
				const values = new Uint8Array(length);
				crypto.getRandomValues(values);
				return [...values].map((value) => String(value % 10)).join('');
			};
			const createPaymentMask = () =>
				`DE${randomDigits(2)} •••• •••• •••• ••${randomDigits(2)} ${randomDigits(2)}`;
			const profileFromForm = async (form) => {
				const data = new FormData(form);
				const canvasPhotoToggle = form.elements.namedItem('canvasPhotoEnabled');
				const qrImage = data.get('qrImage');
				const securityPhoto = data.get('securityPhoto');
				await Promise.all([
					writeMedia('qr', qrImage),
					writeMedia('security', securityPhoto),
				]);
				const profile = {
					qrUrl: qrImage instanceof File && qrImage.size ? URL.createObjectURL(qrImage) : activeProfile?.qrUrl || '',
					securityPhotoUrl: securityPhoto instanceof File && securityPhoto.size ? URL.createObjectURL(securityPhoto) : activeProfile?.securityPhotoUrl || '',
					canvasPhotoEnabled: canvasPhotoToggle instanceof HTMLInputElement
						? canvasPhotoToggle.checked
						: true,
					validFrom: String(data.get('validFrom') ?? ''),
					validUntil: String(data.get('validUntil') ?? ''),
					firstName: String(data.get('firstName') ?? '').trim(),
					lastName: String(data.get('lastName') ?? '').trim(),
					customerId: String(data.get('customerId') ?? '').trim(),
					birthDate: String(data.get('birthDate') ?? ''),
					civ: String(data.get('civ') ?? '').trim(),
					purchasedAt: String(data.get('purchasedAt') ?? ''),
					position: String(data.get('position') ?? '').trim(),
					orderNumber: String(data.get('orderNumber') ?? '').trim(),
					price: String(data.get('price') ?? '').trim().replace('.', ','),
					ticketCode: String(data.get('ticketCode') ?? '').trim(),
				};
				return profile;
			};
			const populateProfileForm = (form, profile) => {
				if (!(form instanceof HTMLFormElement) || !profile) return;
				Object.entries(profile).forEach(([name, value]) => {
					const input = form.elements.namedItem(name);
					if (input instanceof HTMLInputElement && input.type === 'checkbox' && typeof value === 'boolean') {
						input.checked = value;
						return;
					}
					if (input instanceof HTMLInputElement && typeof value === 'string') input.value = value;
				});
			};
			const applyProfile = (profile) => {
				if (!profile) return;
				cacheProfile(profile);
				const fullName = `${profile.firstName} ${profile.lastName}`.trim();
				const birthDate = formatStoredDate(profile.birthDate);
				const validity = calculateValidity(profile.validFrom, profile.validUntil);
				const purchasedAt = formatPurchasedAt(profile.purchasedAt);
				const price = profile.price ? `${String(profile.price).replace('.', ',')} €` : '';

				setDataText('[data-ticket-summary-from]', validity.validFrom);
				setDataText('[data-ticket-card-valid-from]', validity.validFrom ? `Valid from ${validity.validFrom} at 00:00` : '');
				setDataText('[data-ticket-full-name]', fullName);
				setDataText('[data-ticket-birth-date]', birthDate);
				setDataText('[data-ticket-civ]', profile.civ);
				setDataText('[data-ticket-valid-from]', validity.validFrom);
				setDataText('[data-ticket-valid-until]', validity.validUntil);
				setDataText('[data-ticket-purchased-at]', purchasedAt);
				setDataText('[data-ticket-order-number]', profile.orderNumber);
				setDataText('[data-ticket-position]', profile.position);
				setDataText('[data-ticket-price]', price);
				setDataText('[data-ticket-code]', profile.ticketCode);
				setDataText('[data-profile-name]', fullName);
				setDataText('[data-profile-customer-id]', profile.customerId ? `Customer ID ${profile.customerId}` : '');
				setDataText('[data-profile-email]', profile.email);
				setDataText('[data-profile-payment]', profile.paymentMask);
				setDataText('[data-profile-payment-name]', fullName);

				const qrImage = document.querySelector('[data-ticket-qr]');
				if (qrImage instanceof HTMLImageElement) {
					qrImage.hidden = true;
					qrImage.onload = () => {
						qrImage.hidden = false;
					};
					qrImage.onerror = () => {
						qrImage.hidden = true;
					};
					if (profile.qrUrl) {
						qrImage.src = profile.qrUrl;
					}
					else qrImage.removeAttribute('src');
				}

				const inlinePhoto = document.querySelector('[data-ticket-security-photo]');
				if (inlinePhoto instanceof HTMLImageElement) {
					inlinePhoto.hidden = true;
					inlinePhoto.onload = () => {
						inlinePhoto.hidden = false;
					};
					inlinePhoto.onerror = () => {
						inlinePhoto.hidden = true;
					};
					if (profile.securityPhotoUrl) inlinePhoto.src = profile.securityPhotoUrl;
					else inlinePhoto.removeAttribute('src');
				}

				const canvas = document.querySelector('.security-ticket');
				if (canvas instanceof HTMLCanvasElement) {
					const [validDay, validMonth] = validity.validFrom.split('.');
					canvas.dataset.passenger = fullName;
					canvas.dataset.birthDate = birthDate;
					canvas.dataset.validFrom = validity.validFrom;
					canvas.dataset.validDay = validDay ?? '';
					canvas.dataset.validMonth = validMonth ?? '';
					canvas.dataset.orderNumber = profile.orderNumber || '';
					canvas.dataset.position = profile.position || '';
					canvas.dataset.securityPhotoUrl = profile.canvasPhotoEnabled === false
						? ''
						: profile.securityPhotoUrl || '';
				}
			};
			const setFormStatus = (selector, message, error = false) => {
				const status = document.querySelector(selector);
				if (!status) return;
				status.textContent = message;
				status.classList.toggle('error', error);
			};
			const setFormBusy = (form, busy) => {
				if (!(form instanceof HTMLFormElement)) return;
				form.querySelectorAll('button').forEach((button) => {
					button.disabled = busy;
				});
				form.querySelectorAll('input').forEach((input) => {
					input.readOnly = busy;
				});
			};
			const showAuthGate = (show) => {
				authGate?.classList.remove('pending');
				authGate?.classList.toggle('dismissed', !show);
				authGate?.setAttribute('aria-hidden', String(!show));
			};

			const updateArrivalTime = () => {
				const target = document.querySelector('#arrival-time');
				if (!target) return;
				const now = new Date();
				const time = new Intl.DateTimeFormat('en-GB', {
					hour: '2-digit',
					minute: '2-digit',
					hour12: false,
				}).format(now);
				target.textContent = `Arr | Today, ${time}`;
			};

			const bindEdgeSwipe = (panel, closePanel) => {
				if (!(panel instanceof HTMLElement)) return;
				let startX = 0;
				let startY = 0;
				let distance = 0;
				let tracking = false;
				panel.addEventListener('touchstart', (event) => {
					const touch = event.touches[0];
					tracking = touch.clientX <= 28;
					startX = touch.clientX;
					startY = touch.clientY;
					distance = 0;
					if (tracking) panel.classList.add('swiping');
				}, { passive: true });
				panel.addEventListener('touchmove', (event) => {
					if (!tracking) return;
					event.preventDefault();
					const touch = event.touches[0];
					const dx = Math.max(0, touch.clientX - startX);
					const dy = Math.abs(touch.clientY - startY);
					if (dx <= dy) return;
					distance = dx;
					panel.style.setProperty('--swipe-x', `${dx}px`);
				}, { passive: false });
				panel.addEventListener('touchend', () => {
					if (!tracking) return;
					panel.classList.remove('swiping');
					panel.style.removeProperty('--swipe-x');
					if (distance >= 72) closePanel();
					tracking = false;
				}, { passive: true });
			};

			buttons.forEach((button) => button.addEventListener('click', () => {
				const target = button.dataset.target;
				const wasTicketOpen = ticketOpen;
				const wasSettingsOpen = settingsOpen;
				if (wasTicketOpen) setTicketOpen(false, true);
				if (wasSettingsOpen) setSettingsOpen(false, true);
				if (target === 'journeys' && wasTicketOpen) return;
				if (target === 'profile' && wasSettingsOpen) return;
				buttons.forEach((item) => item.classList.toggle('active', item === button));
				screens.forEach((screen) => screen.classList.toggle('active', screen.dataset.screen === target));
				setNearbyCanvas(target === 'nearby');
				document.querySelector(`[data-screen="${target}"]`).scrollTop = 0;
			}));
			document.querySelector('.ticket-card')?.addEventListener('click', () => setTicketOpen(true));
			document.querySelector('.ticket-card')?.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					setTicketOpen(true);
				}
			});
			document.querySelector('[data-open-settings]')?.addEventListener('click', () => {
				const settingsForm = document.querySelector('[data-settings-form]');
				populateProfileForm(settingsForm, activeProfile);
				setSettingsOpen(true);
			});
			bindEdgeSwipe(ticketDetail, () => setTicketOpen(false));
			bindEdgeSwipe(settingsPanel, () => setSettingsOpen(false));
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && ticketOpen) setTicketOpen(false);
				if (event.key === 'Escape' && settingsOpen) setSettingsOpen(false);
			});

			const setupForm = document.querySelector('[data-local-setup-form]');
			const settingsForm = document.querySelector('[data-settings-form]');
			const cachedProfile = readCachedProfile();
			navigator.storage?.persist?.().catch(() => {});

			const hydrateLocalMedia = async (profile) => ({
				...profile,
				qrUrl: await readMediaUrl('qr').catch(() => ''),
				securityPhotoUrl: await readMediaUrl('security').catch(() => ''),
			});

			setupForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!(setupForm instanceof HTMLFormElement)) return;
				setFormBusy(setupForm, true);
				setFormStatus('[data-setup-status]', 'Saving on this device…');
				try {
					const profile = await profileFromForm(setupForm);
					const emailInput = setupForm.elements.namedItem('email');
					activeProfile = {
						...profile,
						email: emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '',
						paymentMask: createPaymentMask(),
					};
					applyProfile(activeProfile);
					populateProfileForm(settingsForm, activeProfile);
					showAuthGate(false);
					setFormStatus('[data-setup-status]', '');
				} catch (error) {
					setFormStatus('[data-setup-status]', error instanceof Error ? error.message : 'Unable to save.', true);
				} finally {
					setFormBusy(setupForm, false);
				}
			});

			settingsForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!(settingsForm instanceof HTMLFormElement)) return;
				setFormBusy(settingsForm, true);
				setFormStatus('[data-settings-status]', 'Saving…');
				try {
					const profile = await profileFromForm(settingsForm);
					const nextProfile = {
						...activeProfile,
						...profile,
						email: activeProfile?.email || '',
						paymentMask: activeProfile?.paymentMask || createPaymentMask(),
					};
					activeProfile = nextProfile;
					applyProfile(activeProfile);
					setFormStatus('[data-settings-status]', 'Saved on this device');
				} catch (error) {
					setFormStatus('[data-settings-status]', error instanceof Error ? error.message : 'Unable to save changes.', true);
				} finally {
					setFormBusy(settingsForm, false);
				}
			});

			document.querySelectorAll('[data-clear-local-data]').forEach((button) => {
				button.addEventListener('click', async () => {
					if (!window.confirm('Delete all ticket information and photos from this device?')) return;
					setSettingsOpen(false, true);
					localStorage.removeItem(profileCacheKey);
					await clearMedia().catch(() => {});
					activeProfile = null;
					showAuthGate(true);
				});
			});

			if (cachedProfile) {
				activeProfile = await hydrateLocalMedia(cachedProfile);
				applyProfile(activeProfile);
				populateProfileForm(settingsForm, activeProfile);
				showAuthGate(false);
			} else {
				showAuthGate(true);
			}

			syncViewportHeight();
			window.visualViewport?.addEventListener('resize', syncViewportHeight);
			window.addEventListener('resize', syncViewportHeight);
			updateArrivalTime();
			setInterval(updateArrivalTime, 1000);
			document.querySelector('.agree-button')?.addEventListener('click', () => {
				document.querySelector('.map-consent')?.classList.add('dismissed');
			});
			document.querySelector('.refresh-button')?.addEventListener('click', () => {
				const screen = document.querySelector('[data-screen="journeys"]');
				if (!screen || screen.classList.contains('is-loading')) return;
				screen.classList.add('is-loading');
				setTimeout(() => {
					screen.classList.remove('is-loading');
					screen.classList.add('is-loaded');
					screen.scrollTop = 0;
				}, 1000);
			});
			document.querySelector('.search-button')?.addEventListener('click', (event) => {
				event.currentTarget.textContent = 'Searching…';
				setTimeout(() => event.currentTarget.textContent = 'Search', 900);
			});
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', async () => {
					const registration = await navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });
					await registration.update();
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
